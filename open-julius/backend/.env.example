# ----------------------------------------------------------------------
# Open Julius configuration
# Copy this file to ".env" and fill in your key:   cp .env.example .env
# ----------------------------------------------------------------------

# Your Google AI Studio API key (get it free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Which Gemini model to use.
#   gemini-2.5-flash  -> fast + cheap, great default (recommended)
#   gemini-2.5-pro    -> smarter, slower, lower free-tier limits
#   gemini-2.0-flash  -> older fast model
GEMINI_MODEL=gemini-2.5-flash

# Max agent reasoning/coding steps per question (safety limit)
MAX_AGENT_TURNS=12
